{
  "name": "sahkku",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Sahkku - a pure TypeScript rules core with an open-license 2D web board",
  "type": "module",
  "license": "SEE LICENSE IN License.txt",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm --prefix Tools/PlaywrightTests test",
    "typecheck": "tsc --noEmit",
    "bench": "tsx src/cli/cli.ts",
    "bench:strategy": "node --import tsx Tools/StrategyBench.ts",
    "prepare": "npm run build --config vite.lib.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/engine.cjs",
  "module": "./dist-lib/engine.js",
  "exports": {
    ".": {
      "import": "./dist-lib/engine.js",
      "require": "./dist-lib/engine.cjs"
    }
  }
}
